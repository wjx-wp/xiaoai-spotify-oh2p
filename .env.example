# Copy this file to .env. Never commit .env.

# Your own Spotify Developer application Client ID. PKCE does not use a client secret.
SPOTIFY_CLIENT_ID=

# Must exactly match the redirect URI registered in your Spotify application.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:43827/callback

# Optional Spotify Connect device name.
SPOTIFY_DEVICE_NAME=XiaoAI Music

# Legacy cloud bridge only. Use your own Xiaomi account and never commit these values.
MI_USER_ID=
MI_PASSWORD=
MI_DEVICE=
MI_TTS_COMMAND=5,3
VOICE_FEEDBACK=errors
POLL_INTERVAL_MS=1200
MI_ENABLE_TRACE=false
