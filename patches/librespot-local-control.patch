diff --git a/src/local_control.rs b/src/local_control.rs
new file mode 100644
index 0000000..72c388e
--- /dev/null
+++ b/src/local_control.rs
@@ -0,0 +1,87 @@
+use log::{info, warn};
+use std::{
+    env, fs, io,
+    os::unix::{fs::PermissionsExt, net::UnixDatagram},
+    path::PathBuf,
+    thread,
+};
+use tokio::sync::mpsc;
+
+#[derive(Clone, Copy, Debug)]
+pub enum LocalControlCommand {
+    Play,
+    Pause,
+    Toggle,
+    Next,
+    Previous,
+    Transfer,
+}
+
+impl LocalControlCommand {
+    fn parse(value: &[u8]) -> Option<Self> {
+        match value.strip_suffix(b"\n").unwrap_or(value) {
+            b"play" => Some(Self::Play),
+            b"pause" => Some(Self::Pause),
+            b"toggle" => Some(Self::Toggle),
+            b"next" => Some(Self::Next),
+            b"previous" => Some(Self::Previous),
+            b"transfer" => Some(Self::Transfer),
+            _ => None,
+        }
+    }
+}
+
+pub struct LocalControl {
+    receiver: mpsc::UnboundedReceiver<LocalControlCommand>,
+}
+
+impl LocalControl {
+    pub fn from_env() -> Option<Self> {
+        let path = env::var_os("LIBRESPOT_CONTROL_SOCKET").map(PathBuf::from)?;
+        match Self::bind(path.clone()) {
+            Ok(control) => {
+                info!("Local control socket listening at {}", path.display());
+                Some(control)
+            }
+            Err(why) => {
+                warn!("Could not create local control socket {}: {why}", path.display());
+                None
+            }
+        }
+    }
+
+    fn bind(path: PathBuf) -> io::Result<Self> {
+        match fs::remove_file(&path) {
+            Ok(()) => {}
+            Err(why) if why.kind() == io::ErrorKind::NotFound => {}
+            Err(why) => return Err(why),
+        }
+        let socket = UnixDatagram::bind(&path)?;
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600))?;
+        let (sender, receiver) = mpsc::unbounded_channel();
+        thread::Builder::new()
+            .name("librespot-local-control".to_string())
+            .spawn(move || {
+                let mut buffer = [0u8; 64];
+                loop {
+                    match socket.recv(&mut buffer) {
+                        Ok(size) => match LocalControlCommand::parse(&buffer[..size]) {
+                            Some(command) if sender.send(command).is_err() => break,
+                            Some(_) => {}
+                            None => warn!("Ignoring unknown local control command"),
+                        },
+                        Err(why) if why.kind() == io::ErrorKind::Interrupted => continue,
+                        Err(why) => {
+                            warn!("Local control socket failed: {why}");
+                            break;
+                        }
+                    }
+                }
+            })?;
+        Ok(Self { receiver })
+    }
+
+    pub async fn recv(&mut self) -> Option<LocalControlCommand> {
+        self.receiver.recv().await
+    }
+}
